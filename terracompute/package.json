{
  "name": "terracompute",
  "version": "0.1.0",
  "private": true,
  "description": "Terracompute server hardware",
  "license": "CERN-OHL-W-2.0",
  "type": "module",
  "scripts": {
    "dev:references": "brep gpu-shelf/references/motherboard.brep.ts --serve --no-open",
    "dev:layout": "brep gpu-shelf/layout/stacked-tiers.brep.ts --serve --no-open",
    "verify:references": "brep verify \"gpu-shelf/references/*.brep.ts\"",
    "verify:layout": "brep verify \"gpu-shelf/layout/*.brep.ts\"",
    "check": "tsc --noEmit",
    "export": "scripts/export.sh"
  },
  "dependencies": {
    "brepjs": "^18.118.3",
    "occt-wasm": "^3.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "brepjs-cad": "^0.44.0",
    "brepjs-skills": "github:andymai/brepjs#path:packages/brepjs-cad/skills",
    "typescript": "catalog:"
  }
}
